# Copy to .env and fill in. .env is git-ignored — NEVER commit real secrets.
# Functions read these via process.env (Netlify dashboard in prod; .env locally
# when running `netlify dev`).

# Airtable Personal Access Token (used by BOTH functions). SECRET — leave blank here.
AIRTABLE_API_KEY=

# Main NEE base (jobs, employees, time, invoices, etc.)
AIRTABLE_BASE_ID=appiqWg6SvKcGfMAu

# Separate inventory/materials base (inventory.js only)
INVENTORY_BASE_ID=appfsLJwfow4CepCw

# Google Maps Distance Matrix — handleCalculateMileage. SECRET — leave blank here.
# This key is used ONLY server-side (airtable.js -> maps.googleapis.com). The
# frontend's "open in maps" link is a plain maps.google.com URL and needs no key.
# THEREFORE: restrict this key by **API restriction** (Distance Matrix API only).
# Do NOT use a "Websites (HTTP referrers)" restriction — function calls are
# server-to-server and send no referrer, so Google returns REQUEST_DENIED on
# every call. IP restriction is also unusable (Netlify function IPs are dynamic).
# Failures are quiet by design: mileage just doesn't render. Symptoms of a broken
# key are a 502 from calculateMileage with Google's reason in `detail`.
# Also note: an expired Google Cloud FREE TRIAL produces the same REQUEST_DENIED
# (this happened 2026-07-27); already-calculated jobs keep showing cached miles,
# so only NEW jobs break — which makes it look address-specific when it isn't.
GOOGLE_MAPS_API_KEY=

# Gates the one-off backfillTimeEntryEmployeeLinks admin action. SECRET.
ADMIN_BACKFILL_TOKEN=

# HMAC key for signing/verifying session tokens (_auth.js, shared by both functions).
# SECRET. REQUIRED — auth fails closed: every request 401s if this is unset. Use a long
# random string (e.g. `openssl rand -hex 32`). For local dev/tests any non-empty value works.
AUTH_SECRET=

# ── NEON MIGRATION (docs/PLAN-time-entries-neon.md) ──
# OPTIONAL, unlike everything above. Postgres connection string for the Neon
# project holding the migrated time_entries. SECRET — leave blank here.
# When set, read handlers may run a SHADOW read against Neon and attach a
# `_shadow` diff block to the response for comparison. Airtable stays
# authoritative; _neon.js FAILS SOFT, so leaving this unset simply disables the
# shadow read. Deliberately NOT part of ensureEnv() — see _neon.js.
DATABASE_URL=

# ── JOBSITE PHOTOS (docs/PLAN-job-photos.md) ──
# OPTIONAL, like DATABASE_URL and unlike everything above it. pCloud OAuth token
# used to read (and later write) each job's photo folder. SECRET — leave blank here.
#
# SCOPE WARNING: this is a FULL read/write credential for the entire NEE pCloud
# account, not a per-folder key. pCloud has no presigned-upload equivalent to
# S3/R2, which is exactly why photos proxy through the function instead of going
# straight from the phone. Never expose it to the browser or log it.
#
# Unset simply disables the in-app photo gallery (the Photos view says so and the
# job page still loads) — _pcloud.js fails soft and is NOT in ensureEnv().
#
# To obtain: register an app in the pCloud developer dashboard, run the OAuth
# code flow once (`node tools/pcloud-oauth.mjs`), and keep the access token.
PCLOUD_ACCESS_TOKEN=

# ALTERNATIVE to PCLOUD_ACCESS_TOKEN — set ONE of the two, not both.
# pCloud's native login token, from `node tools/pcloud-token.mjs`. Use this when
# pCloud's app-registration page is down ("temporarily unavailable"), which is
# common enough that it blocked the first attempt here.
#
# These are NOT interchangeable: pCloud sends OAuth tokens as ?access_token= and
# native tokens as ?auth=. Putting a native token in PCLOUD_ACCESS_TOKEN returns
# "log in failed", which looks like a wrong password rather than a wiring error.
# _pcloud.js reads whichever is set and picks the right parameter.
#
# Tradeoff vs OAuth: a native token can't be revoked per-app — invalidating it
# means changing the account password or calling pCloud's `logout` method.
# Prefer OAuth once app registration works again.
PCLOUD_AUTH_TOKEN=

# pCloud splits accounts across two regions and the WRONG host returns "invalid
# access token" — which looks exactly like a bad credential and will cost you an
# afternoon. The OAuth response tells you which: locationid 1 => api.pcloud.com
# (US), locationid 2 => eapi.pcloud.com (EU). NEE's links are my.pcloud.com (US),
# so the default is correct and this can stay blank.
PCLOUD_API_HOST=api.pcloud.com

# READ-ONLY Airtable PAT scoped to the PRODUCTION base, used only by the offline
# migration scripts in db/etl/. SECRET — leave blank here. Not read by the
# functions. Scopes: data.records:read + schema.bases:read.
AIRTABLE_PROD_READ_PAT=

# ── LOCAL TESTING SAFETY ──
# For local `netlify dev`, point the two base IDs at a DUPLICATED sandbox base
# so write paths (expense push, payroll, invoices) never touch production data:
#   AIRTABLE_BASE_ID=app<your-test-base>
#   INVENTORY_BASE_ID=app<your-test-inventory-base>
